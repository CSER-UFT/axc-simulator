{
  "name": "axc-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Simulador didático de computação aproximada: unidades aritméticas aproximadas, métricas de erro, custo e aplicação",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "synth": "node scripts/synth.mjs",
    "start": "node scripts/serve.mjs 8005",
    "evoapprox": "node scripts/evoapprox.mjs",
    "operands": "node scripts/operands.mjs",
    "axc": "node bin/axc.mjs",
    "experiments": "node scripts/experiments.mjs",
    "vitis:export": "node scripts/vitis.mjs export",
    "vitis:check": "node scripts/vitis.mjs check",
    "vitis:run": "bash build/vitis/run_all.sh",
    "vitis:collect": "node scripts/vitis.mjs collect"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-3.0-only",
  "bin": {
    "axc": "bin/axc.mjs"
  }
}
